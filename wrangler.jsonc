{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentmgmt",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "agentmgmt.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
